{
  "name": "commandcode-go-opencode",
  "version": "0.1.0",
  "description": "Use your Command Code Go subscription with OpenAI/Anthropic-compatible clients (OpenCode, Claude Code, etc.). Unofficial. Localhost-only.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "commandcode-go-opencode": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "command-code",
    "commandcode",
    "opencode",
    "claude-code",
    "openai-compatible",
    "anthropic-compatible",
    "proxy",
    "go-plan"
  ],
  "author": "community",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordon1a/commandcode-go-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/lordon1a/commandcode-go-opencode/issues"
  }
}
